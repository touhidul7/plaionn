# Copy to .env.local and use the project's Connect dialog values.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
# Set either the publishable key below or NEXT_PUBLIC_ANON_KEY to the legacy anon JWT (role=anon).
# Never put a secret/service-role key in a NEXT_PUBLIC_ variable.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_replace_me
# NEXT_PUBLIC_ANON_KEY=eyJ...
NEXT_PUBLIC_APP_URL=http://127.0.0.1:3000
# Privileged secret/service-role keys and database passwords are not needed by these clients.

# On Vercel set APP_URL above to https://YOUR-PROJECT.vercel.app and allow
# that origin plus /auth/callback in Supabase Auth URL Configuration.
